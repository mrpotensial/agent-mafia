# Agent Mafia — Environment Configuration
# Copy this file to .env and fill in your API key

# ─── AI Provider ──────────────────────────────────────────
# Options: "gemini" | "anthropic" | "openai" | "openrouter"
AI_PROVIDER=openrouter

# API Keys (only the one matching AI_PROVIDER is needed)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=YOUR_API_KEY_HERE

# Model (auto-detected from provider if not set)
# Gemini: gemini-2.0-flash
# Anthropic: claude-sonnet-4-5-20250929
# OpenAI: gpt-4o
# OpenRouter: google/gemini-2.0-flash-001
AI_MODEL=
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.8

# ─── Blockchain (Monad) ──────────────────────────────────
# Testnet: https://testnet-rpc.monad.xyz  |  Mainnet: https://rpc.monad.xyz
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Testnet: https://testnet.monadexplorer.com  |  Mainnet: https://monadvision.com
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com
DEPLOYER_PRIVATE_KEY=
GAME_CONTRACT_ADDRESS=
FACTORY_CONTRACT_ADDRESS=

# Nad.fun
NADFUN_API_KEY=

# ─── Server ──────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ─── Game Config ─────────────────────────────────────────
DEFAULT_PLAYER_COUNT=5
DEFAULT_ENTRY_FEE=0.1

# ─── Database ────────────────────────────────────────────
DB_PATH=data/agent-mafia.db
